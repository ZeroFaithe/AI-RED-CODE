# AI: CODE RED — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# true  = single-browser demo mode
# false = cross-computer multiplayer (needs the two Supabase values below)
VITE_DEMO_MODE=false

# Public, browser-safe values from Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY