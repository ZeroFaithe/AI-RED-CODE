# AI: CODE RED — Environment Variables

# ── Demo Mode (Default) ────────────────────────────────────────────────────────
# Works locally without any external services or database!
VITE_DEMO_MODE=true

# ── Multiplayer & Supabase Configuration ──────────────────────────────────────
# Browser-safe (public variables, accessible in frontend bundle):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Server-Only Secrets (Never expose in frontend or git) ──────────────────────
# Used by server/api/actionHandler and server/api/aiHandler
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Optional: Real Gemini/LLM API Key for /api/ai.
# If omitted or empty, the server automatically uses the pure deterministic mock analyst.
AI_API_KEY=
